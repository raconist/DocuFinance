# 3. Global Merchant of Record (LemonSqueezy / Stripe)
VITE_LEMONSQUEEZY_STORE_URL=https://docufinance.lemonsqueezy.com
VITE_LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
