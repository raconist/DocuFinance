# 1. Supabase Cloud PostgreSQL Database (Optional for Cloud Backup & Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Local Payment Gateways (Turkey)
VITE_PAYTR_MERCHANT_ID=948201
